{
  "name": "dyc-academy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4330 --strictPort",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4331 --strictPort",
    "check": "npm run build && npm run test:sites",
    "deploy:dev": "npm run check && npx --yes vercel@59.23.2 deploy",
    "deploy:prod": "npm run check && npx --yes vercel@59.23.2 deploy --prod",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  }
}
